# ==========================================
# Configuración general de Django
# ==========================================
# Clave secreta de Django para desarrollo (en producción generar una segura)
SECRET_KEY=django-insecure-tu-clave-secreta-de-desarrollo

# Modo depuración (True para desarrollo local, False en producción)
DEBUG=True

# Hosts permitidos separados por comas
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# Base de datos
# ==========================================
# Formato: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/colegio_geologos

# ==========================================
# Supabase & Storage
# ==========================================
# URL del proyecto en Supabase (ej. https://xxxx.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave de API de Supabase (anon / public key o service_role según los permisos necesarios)
SUPABASE_KEY=tu-supabase-anon-o-service-key

# Nombre del bucket de almacenamiento (Opcional, por defecto: colegio-media)
SUPABASE_STORAGE_BUCKET=colegio-media
